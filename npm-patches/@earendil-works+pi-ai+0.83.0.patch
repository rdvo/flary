+ * Start the Claude Pro/Max authorization-code flow without opening a local
+ * callback server. This is suitable for a Worker or another remote host.
+ */
+export async function startAnthropicManualOAuth() {
+    const { verifier, challenge } = await generatePKCE();
+    const authParams = new URLSearchParams({
+        code: "true",
+        client_id: CLIENT_ID,
+        response_type: "code",
+        redirect_uri: REDIRECT_URI,
+        scope: SCOPES,
+        code_challenge: challenge,
+        code_challenge_method: "S256",
+        state: verifier,
+    });
+    return {
+        authorizationUrl: `${AUTHORIZE_URL}?${authParams.toString()}`,
+        verifier,
+        state: verifier,
+        redirectUri: REDIRECT_URI,
+        expiresInSeconds: 15 * 60,
+    };
+}
+/**
+ * Complete a Worker-safe Claude Pro/Max authorization flow.
+ */
+export async function completeAnthropicManualOAuth(input, expectedState, verifier, redirectUri = REDIRECT_URI) {
+    const parsed = parseAuthorizationInput(input);
+    if (parsed.state && parsed.state !== expectedState) {
+        throw new Error("OAuth state mismatch");
+    }
+    if (!parsed.code) {
+        throw new Error("Missing authorization code");
+    }
+    return exchangeAuthorizationCode(parsed.code, parsed.state ?? expectedState, verifier, redirectUri);
