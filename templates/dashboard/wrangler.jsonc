{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flary-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "d1_databases": [{ "binding": "FLARY_DASHBOARD_DB" }]
}
