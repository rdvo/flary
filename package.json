{
  "name": "flary",
  "version": "0.8.0-rc.23",
  "description": "Durable, provider-neutral AI agent harness for Cloudflare Workers",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "flary": "dist/cli.js"
  },
  "scripts": {
    "build": "rimraf dist && tsx build.ts",
    "build:watch": "rimraf dist && tsx build.ts --watch",
    "check": "tsc --project tsconfig.build.json --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:live": "node scripts/test-live.cjs",
    "test:npm-install": "node scripts/test-npm-install.cjs",
    "postinstall": "node scripts/apply-dependency-patches.cjs",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdvo/flary.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "flary",
    "cloudflare workers",
    "cloudflare",
    "workers",
    "ai",
    "tools"
  ],
  "author": "rdvo",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rdvo/flary",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/codemode": "0.5.1",
    "@cloudflare/playwright": "1.3.3",
    "@cloudflare/sandbox": "0.12.4",
    "@cloudflare/shell": "0.4.3",
    "@earendil-works/pi-ai": "0.80.10",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/runtime-v2": "npm:@flue/runtime@2.0.2",
    "@flue/sdk": "1.0.0-beta.9",
    "@flue/sdk-v2": "npm:@flue/sdk@2.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "acorn": "^8.18.0",
    "hono": "4.12.34",
    "jsonc-parser": "^3.3.1",
    "patch-package": "8.0.1",
    "valibot": "^1.4.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250729.0",
    "@flue/cli-v2": "npm:@flue/cli@2.0.2",
    "@flue/vite-v2": "npm:@flue/vite@2.0.2",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.17.24",
    "arg": "^5.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "prettier": "^2.8.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/**/*",
    "templates/starter/**/*",
    "templates/dashboard/**/*",
    "npm-patches/*.patch",
    "scripts/apply-dependency-patches.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/types/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    },
    "./client": {
      "types": "./dist/types/harness/client/index.d.ts",
      "import": "./dist/harness/client/index.js"
    },
    "./functions": {
      "types": "./dist/types/harness/functions/index.d.ts",
      "import": "./dist/harness/functions/index.js"
    },
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./cloudflare": {
      "types": "./dist/types/harness/cloudflare/index.d.ts",
      "import": "./dist/harness/cloudflare/index.js"
    },
    "./contracts": {
      "types": "./dist/types/harness/contracts/index.d.ts",
      "import": "./dist/harness/contracts/index.js"
    },
    "./execution": {
      "types": "./dist/types/harness/execution/index.d.ts",
      "import": "./dist/harness/execution/index.js"
    },
    "./prompts": {
      "types": "./dist/types/harness/prompts/index.d.ts",
      "import": "./dist/harness/prompts/index.js"
    },
    "./providers": {
      "types": "./dist/types/harness/providers/index.d.ts",
      "import": "./dist/harness/providers/index.js"
    },
    "./evaluations": {
      "types": "./dist/types/harness/evaluations/index.d.ts",
      "import": "./dist/harness/evaluations/index.js"
    },
    "./recall": {
      "types": "./dist/types/harness/recall/index.d.ts",
      "import": "./dist/harness/recall/index.js"
    },
    "./storage": {
      "types": "./dist/types/harness/storage/index.d.ts",
      "import": "./dist/harness/storage/index.js"
    },
    "./session": {
      "types": "./dist/types/harness/session/index.d.ts",
      "import": "./dist/harness/session/index.js"
    },
    "./subagents": {
      "types": "./dist/types/harness/subagents/index.d.ts",
      "import": "./dist/harness/subagents/index.js"
    },
    "./tools": {
      "types": "./dist/types/harness/tools/index.d.ts",
      "import": "./dist/harness/tools/index.js"
    },
    "./telemetry": {
      "types": "./dist/types/harness/telemetry/index.d.ts",
      "import": "./dist/harness/telemetry/index.js"
    },
    "./mcp": {
      "types": "./dist/types/harness/mcp/index.d.ts",
      "import": "./dist/harness/mcp/index.js"
    },
    "./history": {
      "types": "./dist/types/harness/history/index.d.ts",
      "import": "./dist/harness/history/index.js"
    },
    "./flue": {
      "types": "./dist/types/harness/flue/index.d.ts",
      "import": "./dist/harness/flue/index.js"
    },
    "./host": {
      "types": "./dist/types/harness/host/index.d.ts",
      "import": "./dist/harness/host/index.js"
    },
    "./cli": {
      "types": "./dist/types/cli-api.d.ts",
      "import": "./dist/cli-api.js"
    },
    "./vault": {
      "types": "./dist/types/harness/vault/index.d.ts",
      "import": "./dist/harness/vault/index.js"
    }
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "dompurify": "3.4.13",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "undici": "7.29.0"
    },
    "patchedDependencies": {
    "@cloudflare/codemode@0.5.1": "patches/@cloudflare+codemode+0.5.1.patch",
    "@flue/runtime@1.0.0-beta.9": "patches/@flue__runtime@1.0.0-beta.9.patch",
    "@earendil-works/pi-ai@0.80.10": "patches/@earendil-works__pi-ai@0.80.10.patch",
    "turndown@7.2.4": "patches/turndown+7.2.4.patch"
    }
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "hono": "$hono",
    "undici": "7.29.0"
  }
}
