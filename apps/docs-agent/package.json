{
  "name": "@flary/docs-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8790",
    "build": "tsc --noEmit && vite build",
    "deploy": "pnpm run build && wrangler deploy --config dist/flary_docs_agent/wrangler.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.1",
    "@flue/runtime": "1.0.0-beta.9",
    "agents": "0.20.1",
    "flary": "workspace:*",
    "hono": "4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@flue/cli": "1.0.0-beta.9",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  }
}
