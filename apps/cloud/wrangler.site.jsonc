{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flary-web-local",
  "account_id": "26fadb0e7fb3b317bc68bd136f7e9329",
  "main": "worker/site.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "APP_ENV": "development"
  },
  "env": {
    "production": {
      "name": "flary-web",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "flary.dev",
          "custom_domain": true
        },
        {
          "pattern": "docs.flary.dev",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "production"
      },
      "services": [
        {
          "binding": "FLARY_RUNTIME",
          "service": "flary-cloud"
        },
        {
          "binding": "FLARY_DOCS_AGENT",
          "service": "flary-docs-agent"
        }
      ],
      "ratelimits": [
        {
          "name": "DOCS_CHAT_RATE_LIMITER",
          "namespace_id": "88001",
          "simple": {
            "limit": 12,
            "period": 60
          }
        }
      ]
    }
  }
}
