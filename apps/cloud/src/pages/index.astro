---
import { ArrowUpRight } from "lucide-react";
import { CodeExamples } from "../components/CodeExamples";
import { InstallCommand } from "../components/InstallCommand";
import SiteLayout from "../layouts/SiteLayout.astro";

const capabilities = [
  {
    title: "Persistent threads",
    body: "Runs survive disconnects and resume from an exact event cursor.",
  },
  {
    title: "Safe actions",
    body: "Reads can run directly. Writes and sensitive browser actions can pause for approval.",
  },
  {
    title: "Small tool surface",
    body: "Start with one executor and protected controls. Search and load application, MCP, and API tools only when needed.",
  },
  {
    title: "Parallel execution",
    body: "Run independent reads together and serialize writes by resource.",
  },
  {
    title: "Provider sessions",
    body: "Switch providers while Flary preserves the visible thread and cache lineage.",
  },
  {
    title: "Workspaces and recall",
    body: "Give agents branch-scoped files, diffs, checkpoints, and exact history lookup.",
  },
];

const title = "Flary | Open-source agent infrastructure";
const description =
  "Build durable coding agents, support bots, and product copilots on Cloudflare Workers.";
---

<SiteLayout title={title} description={description}>
  <main class="page">
    <header class="nav">
      <a class="brand" href="#top" aria-label="Flary home">
        <span class="mark" aria-hidden="true">f</span>
        <span>Flary</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#examples">Examples</a>
        <a href="#setup">Setup</a>
        <a href="/docs/">Docs</a>
        <a
          href="https://github.com/rdvo/flary"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <ArrowUpRight size={13} strokeWidth={1.7} />
        </a>
      </nav>
    </header>

    <section class="hero" id="top">
      <div class="hero-label">
        <p class="eyebrow">Open-source agent infrastructure</p>
      </div>
      <div class="hero-copy">
        <h1>Durable agents,<br />inside your app.</h1>
        <p class="lede">
          Build coding agents, support bots, and product copilots with
          persistent threads, tools, and provider-neutral sessions.
        </p>
        <div class="actions">
          <a
            class="primary-link"
            href="https://github.com/rdvo/flary"
            target="_blank"
            rel="noreferrer"
          >
            <ArrowUpRight size={16} strokeWidth={1.7} />
            View on GitHub
          </a>
          <InstallCommand client:idle />
        </div>
        <p class="meta">Apache-2.0 · TypeScript · Cloudflare-native</p>
      </div>
    </section>

    <section class="examples" id="examples">
      <div class="section-intro">
        <p class="eyebrow">Real product patterns</p>
        <h2>One runtime.<br />Different products.</h2>
      </div>
      <CodeExamples client:visible />
      <p class="editor-note">
        These are editable Monaco files that use Flary’s public package APIs.
        Tracked and Fairway Florist are verified Flary integrations.
      </p>
    </section>

    <section class="setup" id="setup">
      <div class="section-intro">
        <p class="eyebrow">One guided setup</p>
        <h2>From zero to a live<br />agent Worker.</h2>
      </div>
      <div class="setup-grid">
        <article>
          <span>01</span>
          <p class="setup-kicker">Create</p>
          <h3>Run the wizard</h3>
          <p>
            Choose a personal dashboard or an agent backend. Select your model
            provider and optional features.
          </p>
          <code>npx flary create</code>
        </article>
        <article>
          <span>02</span>
          <p class="setup-kicker">Authorize</p>
          <h3>Sign in to Cloudflare</h3>
          <p>
            Wrangler OAuth opens in your browser. Choose the account that will
            own the Worker, secrets, and data.
          </p>
          <code>No token copying</code>
        </article>
        <article>
          <span>03</span>
          <p class="setup-kicker">Deploy</p>
          <h3>Open the result</h3>
          <p>
            Flary provisions the resources, uploads secrets, deploys, and
            checks the live Worker.
          </p>
          <code>npx flary deploy</code>
        </article>
      </div>
      <div class="resource-line" aria-label="Cloudflare resource requirements">
        <div>
          <span>Required for durable production</span>
          <strong>Worker · Durable Objects · D1 · R2 · Queue</strong>
        </div>
        <div>
          <span>Optional by feature</span>
          <strong>Browser Run · Sandbox</strong>
        </div>
      </div>
    </section>

    <section class="details" id="details">
      <div class="section-intro">
        <p class="eyebrow">The runtime layer</p>
        <h2>Your product owns the experience.<br />Flary runs the agent.</h2>
      </div>
      <div class="capability-grid">
        {
          capabilities.map((capability, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{capability.title}</h3>
              <p>{capability.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="flow">
      <div>
        <p class="eyebrow">One clean boundary</p>
        <h2>Your UI and auth.<br />Flary underneath.</h2>
      </div>
      <pre aria-label="Flary application architecture"><code>your product
  ↓
flary
  ↓
threads · tools · workspaces
  ↓
durable objects · d1 · optional r2
  ↓
openai · anthropic · google · kimi</code></pre>
    </section>

    <section class="flow">
      <div>
        <p class="eyebrow">A small model-visible core</p>
        <h2>Many tools.<br />One safe runtime.</h2>
        <p class="lede">
          Common controls stay direct. Application tools remain in a private
          catalog until the agent needs them. Schemas, credentials, and large
          results do not fill every model request.
        </p>
        <p>
          <a href="/docs/tools/">See how tools, Code Mode, MCP, and OpenAPI work</a>
        </p>
      </div>
      <pre aria-label="Flary tool runtime"><code>model
  ├─ request_user_input
  ├─ request_secret
  └─ execute
       ├─ tools.search
       ├─ tools.describe
       ├─ tools.call
       └─ tools.batch
            ↓
local · mcp · openapi · workspace
            ↓
policy · approval · replay · audit</code></pre>
    </section>

    <footer>
      <a class="brand" href="#top">
        <span class="mark" aria-hidden="true">f</span>
        <span>Flary</span>
      </a>
      <p>Open-source agent infrastructure for Cloudflare Workers.</p>
      <a
        href="https://www.npmjs.com/package/flary"
        target="_blank"
        rel="noreferrer"
      >
        npm <ArrowUpRight size={12} strokeWidth={1.7} />
      </a>
    </footer>
  </main>
</SiteLayout>
