---
import { ArrowUpRight } from "lucide-react";
import { CodeExamples } from "../components/CodeExamples";
import { InstallCommand } from "../components/InstallCommand";
import SiteLayout from "../layouts/SiteLayout.astro";

const capabilities = [
  {
    title: "Persistent threads",
    body: "Runs survive disconnects and resume from an exact event cursor.",
  },
  {
    title: "Modes and approvals",
    body: "Use Ask, Plan, Build, Review, or a custom Zod permission profile.",
  },
  {
    title: "Lazy tools and MCP",
    body: "Search and load tools only when needed. Keep credentials out of model context.",
  },
  {
    title: "Parallel execution",
    body: "Run independent reads together and serialize writes by resource.",
  },
  {
    title: "Provider sessions",
    body: "Switch providers while Flary preserves the visible thread and cache lineage.",
  },
  {
    title: "Workspaces and recall",
    body: "Give agents branch-scoped files, diffs, checkpoints, and exact history lookup.",
  },
];

const title = "Flary — Open-source agent infrastructure";
const description =
  "Build durable coding agents, support bots, and product copilots on Cloudflare Workers.";
---

<SiteLayout title={title} description={description}>
  <main class="page">
    <header class="nav">
      <a class="brand" href="#top" aria-label="Flary home">
        <span class="mark" aria-hidden="true">f</span>
        <span>Flary</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#examples">Examples</a>
        <a href="#setup">Setup</a>
        <a
          href="https://github.com/rdvo/flary/tree/main/docs"
          target="_blank"
          rel="noreferrer"
        >
          Docs
        </a>
        <a
          href="https://github.com/rdvo/flary"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <ArrowUpRight size={13} strokeWidth={1.7} />
        </a>
      </nav>
    </header>

    <section class="hero" id="top">
      <div class="hero-label">
        <p class="eyebrow">Open-source agent infrastructure</p>
      </div>
      <div class="hero-copy">
        <h1>Durable agents,<br />inside your app.</h1>
        <p class="lede">
          Build coding agents, support bots, and product copilots with
          persistent threads, tools, and provider-neutral sessions.
        </p>
        <div class="actions">
          <a
            class="primary-link"
            href="https://github.com/rdvo/flary"
            target="_blank"
            rel="noreferrer"
          >
            <ArrowUpRight size={16} strokeWidth={1.7} />
            View on GitHub
          </a>
          <InstallCommand client:idle />
        </div>
        <p class="meta">Apache-2.0 · TypeScript · Cloudflare-native</p>
      </div>
    </section>

    <section class="examples" id="examples">
      <div class="section-intro">
        <p class="eyebrow">Real project code</p>
        <h2>One runtime.<br />Different products.</h2>
      </div>
      <CodeExamples client:visible />
      <p class="editor-note">
        These are editable Monaco files. The examples use Flary’s public
        package APIs, not a landing-page-only SDK.
      </p>
    </section>

    <section class="setup" id="setup">
      <div class="section-intro">
        <p class="eyebrow">Start local, deploy durable</p>
        <h2>Use only the layer<br />your app needs.</h2>
      </div>
      <div class="setup-grid">
        <article>
          <span>01</span>
          <p class="setup-kicker">Prompt files</p>
          <h3>Any TypeScript app</h3>
          <p>
            Compile tracked <code>*.prompt.md</code> files with no Cloudflare
            resources.
          </p>
          <code>npm install flary@next</code>
        </article>
        <article>
          <span>02</span>
          <p class="setup-kicker">Local runtime</p>
          <h3>Cloudflare emulation</h3>
          <p>
            Start with the generated prompt Worker. Add locally emulated
            Durable Objects and D1 when you add threads.
          </p>
          <code>npx flary create my-agent</code>
        </article>
        <article>
          <span>03</span>
          <p class="setup-kicker">Production runtime</p>
          <h3>Your Cloudflare account</h3>
          <p>
            Durable Objects run threads. D1 indexes runs. Add R2 only for
            large files or history fallback.
          </p>
          <code>wrangler deploy</code>
        </article>
      </div>
      <div class="resource-line" aria-label="Cloudflare resource requirements">
        <div>
          <span>Required for durable production</span>
          <strong>Worker · Durable Objects · D1</strong>
        </div>
        <div>
          <span>Optional by feature</span>
          <strong>R2 · Sandbox · Dynamic Workers · Artifacts</strong>
        </div>
      </div>
    </section>

    <section class="details" id="details">
      <div class="section-intro">
        <p class="eyebrow">The runtime layer</p>
        <h2>Your product owns the experience.<br />Flary runs the agent.</h2>
      </div>
      <div class="capability-grid">
        {
          capabilities.map((capability, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{capability.title}</h3>
              <p>{capability.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="flow">
      <div>
        <p class="eyebrow">One clean boundary</p>
        <h2>Your UI and auth.<br />Flary underneath.</h2>
      </div>
      <pre aria-label="Flary application architecture"><code>your product
  ↓
flary
  ↓
threads · tools · workspaces
  ↓
durable objects · d1 · optional r2
  ↓
openai · anthropic · google · kimi</code></pre>
    </section>

    <footer>
      <a class="brand" href="#top">
        <span class="mark" aria-hidden="true">f</span>
        <span>Flary</span>
      </a>
      <p>Open-source agent infrastructure for Cloudflare Workers.</p>
      <a
        href="https://www.npmjs.com/package/flary"
        target="_blank"
        rel="noreferrer"
      >
        npm <ArrowUpRight size={12} strokeWidth={1.7} />
      </a>
    </footer>
  </main>
</SiteLayout>
