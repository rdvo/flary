---
import { getCollection } from "astro:content";
import {
  ArrowRight,
  Cloud,
  FileCode2,
  MessagesSquare,
} from "lucide-react";
import { docPath, sortDocs } from "../../docs";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entries = sortDocs(await getCollection("docs"));
const examples = entries.filter((entry) => entry.data.section === "Examples");
---

<DocsLayout
  title="Install and build with Flary"
  description="Choose an AI assistant, a team inbox, or an agent backend. Install it in your Cloudflare account and make it your own."
>
  <p>
    Flary brings app setup and an extensible TypeScript framework together. Start
    with an application, then connect your accounts and add the behavior you need.
    <a href="/docs/overview/">See the full package</a> or
    <a href="/docs/why-flary/">compare Flary with Flue and the Agents SDK</a>.
  </p>
  <section class="docs-start-grid">
    <a href="/docs/quickstart/">
      <FileCode2 size={18} strokeWidth={1.6} />
      <span>Start</span>
      <h2>Choose your app</h2>
      <p>Install a personal AI dashboard, an agent backend, or a self-hosted team inbox.</p>
      <strong>Open install guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
    <a href="/docs/clients/">
      <MessagesSquare size={18} strokeWidth={1.6} />
      <span>Connect</span>
      <h2>Build your UI or bot</h2>
      <p>Connect your own UI, bot, or service through typed APIs and realtime clients.</p>
      <strong>Open client guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
    <a href="/docs/deploy/">
      <Cloud size={18} strokeWidth={1.6} />
      <span>Deploy</span>
      <h2>Deploy to Cloudflare</h2>
      <p>Own the Worker, resources, secrets, and data without managing a VPS.</p>
      <strong>Open deploy guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
  </section>

  <section class="docs-install-block">
    <div>
      <span>Current release</span>
      <h2>Add the framework to an existing project.</h2>
    </div>
    <pre><code>npm install flary</code></pre>
  </section>

  <section class="docs-home-section">
    <div class="docs-home-section__title">
      <MessagesSquare size={18} strokeWidth={1.6} />
      <div>
        <span>Examples</span>
        <h2>See what you can build.</h2>
      </div>
    </div>
    <div class="docs-example-links">
      {
        examples.map((entry) => (
          <a href={docPath(entry.id)}>
            <div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </div>
            <ArrowRight size={16} strokeWidth={1.7} />
          </a>
        ))
      }
    </div>
  </section>
</DocsLayout>
