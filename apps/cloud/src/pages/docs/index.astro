---
import { getCollection } from "astro:content";
import {
  ArrowRight,
  Cloud,
  FileCode2,
  MessagesSquare,
} from "lucide-react";
import { docPath, sortDocs } from "../../docs";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entries = sortDocs(await getCollection("docs"));
const examples = entries.filter((entry) => entry.data.section === "Examples");
---

<DocsLayout
  title="Build with Flary"
  description="Create a typed function or persistent agent and deploy it to your Cloudflare account."
>
  <section class="docs-start-grid">
    <a href="/docs/quickstart/">
      <FileCode2 size={18} strokeWidth={1.6} />
      <span>Start</span>
      <h2>Run the wizard</h2>
      <p>Choose a personal dashboard or headless agent backend and deploy it.</p>
      <strong>Open guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
    <a href="/docs/clients/">
      <MessagesSquare size={18} strokeWidth={1.6} />
      <span>Connect</span>
      <h2>Build your UI or bot</h2>
      <p>Use Flary headlessly from a web UI, mobile app, Telegram, Discord, or a webhook.</p>
      <strong>Open client guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
    <a href="/docs/deploy/">
      <Cloud size={18} strokeWidth={1.6} />
      <span>Deploy</span>
      <h2>Deploy to Cloudflare</h2>
      <p>Own the Worker, resources, secrets, and data without managing a VPS.</p>
      <strong>Open deploy guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
  </section>

  <section class="docs-install-block">
    <div>
      <span>Current release</span>
      <h2>Install the latest release.</h2>
    </div>
    <pre><code>npm install flary</code></pre>
  </section>

  <section class="docs-home-section">
    <div class="docs-home-section__title">
      <MessagesSquare size={18} strokeWidth={1.6} />
      <div>
        <span>Examples</span>
        <h2>Start from a real product shape.</h2>
      </div>
    </div>
    <div class="docs-example-links">
      {
        examples.map((entry) => (
          <a href={docPath(entry.id)}>
            <div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </div>
            <ArrowRight size={16} strokeWidth={1.7} />
          </a>
        ))
      }
    </div>
  </section>
</DocsLayout>
