---
import { getCollection } from "astro:content";
import {
  ArrowRight,
  Cloud,
  FileCode2,
  HardDrive,
  MessagesSquare,
} from "lucide-react";
import { docPath, sortDocs } from "../../docs";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entries = sortDocs(await getCollection("docs"));
const examples = entries.filter((entry) => entry.data.section === "Examples");
---

<DocsLayout
  title="Build with Flary"
  description="Start with a typed function call, self-host durable runs, or embed the runtime in an existing product."
>
  <section class="docs-start-grid">
    <a href="/docs/one-off-agent/">
      <FileCode2 size={18} strokeWidth={1.6} />
      <span>Run once</span>
      <h2>One-off agent call</h2>
      <p>Define a typed function, call it directly, or start it as a durable run.</p>
      <strong>Open guide <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
    <a href="/docs/sessions-and-workspaces/">
      <HardDrive size={18} strokeWidth={1.6} />
      <span>Understand</span>
      <h2>Sessions and files</h2>
      <p>See where messages, workspaces, checkpoints, audits, and archives live.</p>
      <strong>Learn the storage model <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
    <a href="/docs/self-hosting/">
      <Cloud size={18} strokeWidth={1.6} />
      <span>Deploy</span>
      <h2>Self-host on Cloudflare</h2>
      <p>Mount durable threads, resumable events, tools, approvals, and tenant policy.</p>
      <strong>Self-host Flary <ArrowRight size={14} strokeWidth={1.7} /></strong>
    </a>
  </section>

  <section class="docs-install-block">
    <div>
      <span>Current release</span>
      <h2>Install the latest release.</h2>
    </div>
    <pre><code>npm install flary</code></pre>
  </section>

  <section class="docs-home-section">
    <div class="docs-home-section__title">
      <MessagesSquare size={18} strokeWidth={1.6} />
      <div>
        <span>Examples</span>
        <h2>Start from a real product shape.</h2>
      </div>
    </div>
    <div class="docs-example-links">
      {
        examples.map((entry) => (
          <a href={docPath(entry.id)}>
            <div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </div>
            <ArrowRight size={16} strokeWidth={1.7} />
          </a>
        ))
      }
    </div>
  </section>
</DocsLayout>
