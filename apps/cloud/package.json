{
  "name": "flary-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Flary Cloud control plane and self-hostable Cloudflare app",
  "type": "module",
  "scripts": {
    "font:build": "python3 fonts/build_flary_sans.py",
    "dev": "pnpm run site:build && vite --host 127.0.0.1",
    "dev:site": "astro dev --host 127.0.0.1 --port 5173",
    "dev:web-worker": "vite --host 127.0.0.1 --port 8788",
    "dev:runtime": "NODE_OPTIONS=--max-old-space-size=4096 vite --config vite.runtime.config.ts --host 127.0.0.1 --port 8787",
    "site:build": "rimraf .astro-dist && astro build",
    "web-worker:build": "rimraf dist/client dist/flary_web_local && vite build",
    "build": "pnpm run site:build && pnpm run web-worker:build",
    "build:production": "CLOUDFLARE_ENV=production pnpm run build",
    "build:runtime": "rimraf dist/runtime && flue build --target cloudflare --root . --output dist/runtime",
    "preview": "vite preview",
    "deploy:web": "pnpm run build:production && wrangler deploy --config dist/flary_web_local/wrangler.json",
    "deploy:runtime": "CLOUDFLARE_ENV=production pnpm run build:runtime && wrangler deploy --config dist/runtime/flary_cloud_local/wrangler.json",
    "types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --strict-vars",
    "typecheck": "astro check && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flary-cloud-local --local",
    "db:migrate:remote": "wrangler d1 migrations apply flary-cloud --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.24",
    "@cloudflare/sandbox": "0.12.4",
    "@cloudflare/shell": "0.4.3",
    "@flue/runtime": "1.0.0-beta.9",
    "@monaco-editor/react": "4.7.0",
    "agents": "0.20.1",
    "better-auth": "^1.6.24",
    "drizzle-orm": "^0.45.2",
    "flary": "workspace:*",
    "hono": "^4.12.30",
    "lucide-react": "^0.511.0",
    "monaco-editor": "0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "valibot": "1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/vite-plugin": "^1.21.0",
    "@flue/cli": "1.0.0-beta.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "astro": "^7.1.6",
    "cookie": "^2.0.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "wrangler": "^4.30.0"
  }
}
